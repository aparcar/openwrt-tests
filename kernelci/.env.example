# OpenWrt KernelCI Environment Configuration
#
# Copy to .env and fill in the values:
#   cp .env.example .env
#
# NEVER commit the .env file to version control.

# ---------------------------------------------------------------------------
# Domain (required for HTTPS)
# ---------------------------------------------------------------------------

# Your domain name — must have a DNS A record pointing to this server
# Dashboard will be at https://DOMAIN
# API will be at https://api.DOMAIN
# Storage console at https://storage.DOMAIN
DOMAIN=openwrt-kci.example.org

# Email for Let's Encrypt certificate notifications
ACME_EMAIL=admin@example.org

# ---------------------------------------------------------------------------
# Maestro API (MongoDB + JWT)
# ---------------------------------------------------------------------------

MONGO_USER=admin

# Generate: openssl rand -hex 16
MONGO_PASSWORD=CHANGE_ME

# JWT secret for Maestro API — minimum 32 characters
# Generate: openssl rand -hex 32
KCI_SECRET_KEY=CHANGE_ME

# API token for the pipeline services (trigger + scheduler + bridge)
# Generate after first startup — see README.md for instructions
KCI_API_TOKEN=CHANGE_ME

# ---------------------------------------------------------------------------
# KCIDB (PostgreSQL + JWT for result submission)
# ---------------------------------------------------------------------------

# PostgreSQL password for KCIDB database (all roles use the same password)
# Generate: openssl rand -hex 16
KCIDB_PG_PASSWORD=CHANGE_ME

# JWT secret for KCIDB REST submission endpoint
# Generate: openssl rand -hex 32
KCIDB_JWT_SECRET=CHANGE_ME

# Origin identifier for submitted results (your project name)
KCIDB_ORIGIN=openwrt

# ---------------------------------------------------------------------------
# MinIO (S3-compatible storage for test logs)
# ---------------------------------------------------------------------------

MINIO_ACCESS_KEY=openwrt

# Generate: openssl rand -hex 16
MINIO_SECRET_KEY=CHANGE_ME

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# GitHub token for PR firmware testing (needs repo:read scope)
# GITHUB_TOKEN=ghp_...
