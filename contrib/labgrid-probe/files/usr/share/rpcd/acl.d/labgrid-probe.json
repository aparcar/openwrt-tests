	},
	"labgrid-probe": {
		"description": "labgrid-probe, for logins that should control it",
		"read": { "ubus": { "labgrid-probe": [ "info", "addresses", "speedtest_result", "mcast_result" ] } },
		"write": { "ubus": { "labgrid-probe": [ "up", "wan_up", "wan_dhcp", "down", "dhcp", "ping", "resolve", "speedtest_start", "ra_capture", "mcast_join", "mcast_send", "mcast_leave" ] } }
	}
