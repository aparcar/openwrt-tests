KCI_API_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJhcGFyY2FyIiwidHlwZSI6ImxhYiIsImlhdCI6MTc3MDE1ODE0NywiZXhwIjoxODAxNjk0MTQ3fQ.pBNLuPSrmYpmbpjAIId1fwQQQT3hhutIiIgZQx9UUhk

# Labgrid coordinator (local to this host)
