TESTS_REPO_BRANCH=main

# Paths (relative to cloned repo or absolute)
TARGETS_DIR=./targets
TESTS_DIR=./tests
FIRMWARE_CACHE=/home/labgrid-dev/labgrid-kci-adapter/cache

# Device discovery
REQUIRE_TARGET_FILES=false
DEVICE_DISCOVERY_INTERVAL=300

# Job execution
MAX_CONCURRENT_JOBS=3
POLL_INTERVAL=30

# Health checks
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=86400

# Logging
LOG_LEVEL=INFO
