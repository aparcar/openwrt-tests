#!/bin/sh /etc/rc.common
# Managed by Ansible (openwrt-tests, role labgrid_lab_openwrt). places.yaml
# lives in the coordinator's working directory. It listens on loopback only:
# the exporter and the agent run on this host, developers come in through
# LG_PROXY (SSH), and OpenWrt's LAN zone accepts input by default.

USE_PROCD=1
START=95
STOP=10

start_service() {
	procd_open_instance
	procd_set_param command /bin/sh -c 'cd {{ labgrid_coordinator_dir }} && exec {{ uv_tool_bin_dir }}/labgrid-coordinator --listen 127.0.0.1:20408'
	procd_set_param user {{ labgrid_coordinator_user }}
	procd_set_param env PYTHONUNBUFFERED=1
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
