#!/bin/sh /etc/rc.common
# Managed by Ansible (openwrt-tests, role labgrid_lab_openwrt). Own system
# account in group {{ labgrid_group }} (serial ports and GPIOs, see
# /etc/init.d/labgrid-lab); it starts ser2net for acquired serial ports.

USE_PROCD=1
START=96
STOP=09

start_service() {
	procd_open_instance
	procd_set_param command {{ uv_tool_bin_dir }}/labgrid-exporter --hostname "{{ inventory_hostname }}" {{ labgrid_config_dir }}/exporter.yaml
	procd_set_param user {{ labgrid_exporter_user }}
	procd_set_param group {{ labgrid_group }}
	procd_set_param env PYTHONUNBUFFERED=1
	# labgrid_lab: Restart=always, RestartSec=30
	procd_set_param respawn 3600 30 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
