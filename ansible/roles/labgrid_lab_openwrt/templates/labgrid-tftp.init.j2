#!/bin/sh /etc/rc.common
# Managed by Ansible (openwrt-tests, role labgrid_lab_openwrt). TFTP for the
# DUTs: a dnsmasq of its own, TFTP only (no DNS, no DHCP). The system dnsmasq
# runs in a ujail that only mounts its tftp_root, where labgrid's symlinks
# (to its staging cache or the agent's firmware cache) dangle; this one runs
# unjailed, as user dnsmasq in group {{ labgrid_group }}, like labgrid_lab's.
# Listens on the TFTP servers of {{ inventory_hostname }}'s exporter.yaml.

USE_PROCD=1
START=95
STOP=10

{% set addresses = [] %}
{% for group in _exporter.values() if group is mapping %}
{% for name, res in group.items() if res is mapping %}
{% if (res.cls | default(name)) in ['TFTPProvider', 'RemoteTFTPProvider'] and (res.external | default('')) is match('tftp://') %}
{% set _ = addresses.append(res.external | urlsplit('hostname')) %}
{% endif %}
{% endfor %}
{% endfor %}
start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/dnsmasq --keep-in-foreground \
		--conf-file=/dev/null --pid-file= --port=0 --bind-dynamic \
{% for address in addresses | unique %}
		--listen-address={{ address }} \
{% endfor %}
		--enable-tftp --tftp-root={{ labgrid_tftp_root }} \
		--user=dnsmasq --group={{ labgrid_group }}
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
