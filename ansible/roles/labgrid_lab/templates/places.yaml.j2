{% for device in labnet["labs"][inventory_hostname]["devices"] %}
{% set device_instances = labnet["labs"][inventory_hostname].get("device_instances", {}).get(device, [device]) %}
{% for instance in device_instances %}
{{ inventory_hostname }}-{{ instance }}:
  acquired: null
  acquired_resources: []
  aliases: []
  allowed: []
  changed: {{ ansible_date_time.epoch }}
  comment: ''
  created: {{ ansible_date_time.epoch }}
  matches:
  - cls: '*'
    exporter: '*'
    group: {{ inventory_hostname }}-{{ instance }}
    name: null
    rename: null
  tags:
    device: {{ device }}
{% endfor %}
{% endfor %}
{% if labnet["labs"][inventory_hostname].get("probe") %}
{{ inventory_hostname }}-probe:
  acquired: null
  acquired_resources: []
  aliases: []
  allowed: []
  changed: {{ ansible_date_time.epoch }}
  comment: 'labgrid-probe (contrib/labgrid-probe)'
  created: {{ ansible_date_time.epoch }}
  matches:
  - cls: '*'
    exporter: '*'
    group: {{ inventory_hostname }}-probe
    name: null
    rename: null
  tags:
    role: probe
{% endif %}
{% if labnet["labs"][inventory_hostname].get("wifi_probe") %}
{{ inventory_hostname }}-wifi-probe:
  acquired: null
  acquired_resources: []
  aliases: []
  allowed: []
  changed: {{ ansible_date_time.epoch }}
  comment: 'Wi-Fi client probe (contrib/labgrid-probe, ath9k)'
  created: {{ ansible_date_time.epoch }}
  matches:
  - cls: '*'
    exporter: '*'
    group: {{ inventory_hostname }}-wifi-probe
    name: null
    rename: null
  tags:
    role: wifi-probe
{% endif %}
{% if labnet["labs"][inventory_hostname].get("nixos_probe") %}
{{ inventory_hostname }}-nixos-probe:
  acquired: null
  acquired_resources: []
  aliases: []
  allowed: []
  changed: {{ ansible_date_time.epoch }}
  comment: 'NixOS probe (contrib/nixos-probe)'
  created: {{ ansible_date_time.epoch }}
  matches:
  - cls: '*'
    exporter: '*'
    group: {{ inventory_hostname }}-nixos-probe
    name: null
    rename: null
  tags:
    role: nixos-probe
{% endif %}
