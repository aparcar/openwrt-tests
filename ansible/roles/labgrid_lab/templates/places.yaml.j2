{# maintenance: {<device or instance>: <reason>}: the agent skips these places; a
   tag set with labgrid-client set-tags is gone after the next deploy #}
{% set maintenance = labnet["labs"][inventory_hostname].get("maintenance", {}) %}
{% for device in labnet["labs"][inventory_hostname]["devices"] %}
{% set device_instances = labnet["labs"][inventory_hostname].get("device_instances", {}).get(device, [device]) %}
{% for instance in device_instances %}
{{ inventory_hostname }}-{{ instance }}:
  acquired: null
  acquired_resources: []
  aliases: []
  allowed: []
  changed: {{ ansible_date_time.epoch }}
  comment: ''
  created: {{ ansible_date_time.epoch }}
  matches:
  - cls: '*'
    exporter: '*'
    group: {{ inventory_hostname }}-{{ instance }}
    name: null
    rename: null
  tags:
    device: {{ device }}
{% if instance in maintenance %}
    maintenance: {{ maintenance[instance] }}
{% endif %}
{% endfor %}
{% endfor %}
{% if labnet["labs"][inventory_hostname].get("probe") %}
{{ inventory_hostname }}-probe:
  acquired: null
  acquired_resources: []
  aliases: []
  allowed: []
  changed: {{ ansible_date_time.epoch }}
  comment: 'labgrid-probe (contrib/labgrid-probe)'
  created: {{ ansible_date_time.epoch }}
  matches:
  - cls: '*'
    exporter: '*'
    group: {{ inventory_hostname }}-probe
    name: null
    rename: null
  tags:
    role: probe
{% endif %}
{# wifi_probe: true (one) or the number of Wi-Fi probes: -wifi-probe, -wifi-probe-2, ... #}
{% set wifi_probes = labnet["labs"][inventory_hostname].get("wifi_probe", 0) | int %}
{% for n in range(1, wifi_probes + 1) %}
{% set wifi_place = inventory_hostname ~ "-wifi-probe" ~ ("" if n == 1 else "-" ~ n) %}
{{ wifi_place }}:
  acquired: null
  acquired_resources: []
  aliases: []
  allowed: []
  changed: {{ ansible_date_time.epoch }}
  comment: 'Wi-Fi client probe (contrib/labgrid-probe, ath9k)'
  created: {{ ansible_date_time.epoch }}
  matches:
  - cls: '*'
    exporter: '*'
    group: {{ wifi_place }}
    name: null
    rename: null
  tags:
    role: wifi-probe
{% endfor %}
{% if labnet["labs"][inventory_hostname].get("iphone_probe") %}
{{ inventory_hostname }}-iphone-probe:
  acquired: null
  acquired_resources: []
  aliases: []
  allowed: []
  changed: {{ ansible_date_time.epoch }}
  comment: 'iPhone Wi-Fi client (contrib/iphone-probe)'
  created: {{ ansible_date_time.epoch }}
  matches:
  - cls: '*'
    exporter: '*'
    group: {{ inventory_hostname }}-iphone-probe
    name: null
    rename: null
  tags:
    role: iphone-probe
{% endif %}
{% if labnet["labs"][inventory_hostname].get("android_probe") %}
{{ inventory_hostname }}-android-probe:
  acquired: null
  acquired_resources: []
  aliases: []
  allowed: []
  changed: {{ ansible_date_time.epoch }}
  comment: 'Android Wi-Fi client (contrib/android-probe)'
  created: {{ ansible_date_time.epoch }}
  matches:
  - cls: '*'
    exporter: '*'
    group: {{ inventory_hostname }}-android-probe
    name: null
    rename: null
  tags:
    role: android-probe
{% endif %}
