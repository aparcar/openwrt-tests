{# The places this lab's coordinator should have, for labgrid's
   contrib/sync-places.py (tasks/places.yml). Each place matches the exporter
   group of its name. maintenance: {<device or instance>: <reason>}: the agent
   skips these places; a tag set with labgrid-client set-tags is gone after
   the next deploy #}
{% set maintenance = lab.get("maintenance", {}) %}
{% set places = {} %}
{% for device in lab["devices"] %}
{% for instance in lab.get("device_instances", {}).get(device, [device]) %}
{% set tags = {"device": device} %}
{% if instance in maintenance %}
{% set _ = tags.update({"maintenance": maintenance[instance]}) %}
{% endif %}
{% set _ = places.update({inventory_hostname ~ "-" ~ instance: tags}) %}
{% endfor %}
{% endfor %}
{% if lab.get("probe") %}
{% set _ = places.update({inventory_hostname ~ "-probe": {"role": "probe"}}) %}
{% endif %}
{# wifi_probe: true (one) or the number of Wi-Fi probes: -wifi-probe, -wifi-probe-2, ... #}
{% for n in range(1, (lab.get("wifi_probe", 0) | int) + 1) %}
{% set _ = places.update({inventory_hostname ~ "-wifi-probe" ~ ("" if n == 1 else "-" ~ n): {"role": "wifi-probe"}}) %}
{% endfor %}
{% if lab.get("iphone_probe") %}
{% set _ = places.update({inventory_hostname ~ "-iphone-probe": {"role": "iphone-probe"}}) %}
{% endif %}
{% if lab.get("android_probe") %}
{% set _ = places.update({inventory_hostname ~ "-android-probe": {"role": "android-probe"}}) %}
{% endif %}
places:
{% for name, tags in places.items() %}
  {{ name }}:
    matches:
      - "*/{{ name }}/*"
    tags: {{ tags | to_json }}
{% endfor %}
