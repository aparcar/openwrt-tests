# Managed by Ansible (openwrt-tests, role labgrid_agent). One poll per run: claim available jobs for
# this lab's platforms, run them with openwrt-tests, report back. Hardware
# platforms come from the lab's labgrid-coordinator (device=<platform> place
# tags); only qemu_* platforms are passed. QEMU-only labs run without a
# coordinator (--coordinator=). Health checks of all platforms (unless the
# lab sets health_checks: false; settings in {{ labgrid_agent_config_dir }}/config.toml)
# run when due.
[Unit]
Description=OpenWrt CI labgrid-agent ({{ labgrid_agent_lab_name }})
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User={{ labgrid_agent_user }}
WorkingDirectory={{ labgrid_agent_dir }}/kernelci-labgrid
ExecStart={{ uv_install_dir }}/uv run --project {{ labgrid_agent_dir }}/kernelci-labgrid labgrid-agent \
    --config {{ labgrid_agent_config_dir }}/config.toml \
    --env-file {{ labgrid_agent_config_dir }}/env \
    --pool {{ labgrid_agent_pool }} \
{% if not _agent_hardware %}
    --coordinator= \
{% endif %}
{% if labgrid_agent_max_jobs %}
    --max-jobs {{ labgrid_agent_max_jobs }} \
{% endif %}
    --tests-dir {{ labgrid_agent_dir }}/openwrt-tests/tests \
{% for platform in labgrid_agent_platforms | select('match', '^qemu_') %}
    --platform {{ platform }} \
{% endfor %}
    --artifact-dir {{ labgrid_agent_state_dir }}/artifacts \
{% if not labgrid_agent_health_checks %}
    --no-health-checks \
{% endif %}
    --health-state-file {{ labgrid_agent_state_dir }}/health.json \
    --once
# A full test run can take a while; never kill a run in progress early
TimeoutStartSec=4h
# Tokens only via --env-file, no privilege escalation. No restrictive UMask:
# staged firmware must stay readable for the TFTP server.
NoNewPrivileges=true
