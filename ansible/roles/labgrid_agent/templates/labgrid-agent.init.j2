#!/bin/sh /etc/rc.common
# Managed by Ansible (openwrt-tests, role labgrid_agent). OpenWrt version of
# labgrid-agent.service: the agent polls every {{ labgrid_agent_poll_interval }}s and runs claimed jobs
# and due health checks in the background. Output goes to the system log
# (logread).
#
# `reload` drains: no new jobs, the agent exits once the running ones are
# done and procd starts it again (new code, config, tokens). `restart`/`stop`
# stop at once: running jobs go back to the queue.

USE_PROCD=1
START=99
STOP=05

start_service() {
	procd_open_instance
	# The environment's own entry point, not `uv run`: signals (SIGHUP for
	# the drain) go straight to the agent
	procd_set_param command {{ labgrid_agent_dir }}/kernelci-labgrid/.venv/bin/labgrid-agent \
		--config {{ labgrid_agent_config_dir }}/config.toml \
		--pool {{ labgrid_agent_pool }} \
{% if not _agent_hardware %}
		--coordinator= \
{% elif labgrid_agent_coordinator %}
		--coordinator={{ labgrid_agent_coordinator }} \
{% endif %}
{% if labgrid_agent_max_jobs %}
		--max-jobs {{ labgrid_agent_max_jobs }} \
{% endif %}
		--tests-dir {{ labgrid_agent_dir }}/openwrt-tests/tests \
{% for platform in labgrid_agent_platforms | select('match', '^qemu_') %}
		--platform {{ platform }} \
{% endfor %}
		--artifact-dir {{ labgrid_agent_state_dir }}/artifacts \
{% if not labgrid_agent_health_checks %}
		--no-health-checks \
{% endif %}
		--health-state-file {{ labgrid_agent_state_dir }}/health.json \
		--poll-interval {{ labgrid_agent_poll_interval }}
	procd_set_param user {{ labgrid_agent_user }}
	# procd sets no HOME; uv keeps its Python there
	procd_set_param env HOME={{ _agent_account.home }}
	# Also after a drain (exit 0): start again after 10 s, forever
	procd_set_param respawn 3600 10 0
	# Stopping cancels the running jobs: kill pytest, power off, unlock the place
	procd_set_param term_timeout 180
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	procd_send_signal labgrid-agent '*' HUP
}
