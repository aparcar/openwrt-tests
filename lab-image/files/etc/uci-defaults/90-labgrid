#!/bin/sh
# First boot setup of an OpenWrt labgrid host. Lab specific values come from
# /etc/labgrid/lab.conf, generated by lab-image/generate.py from labnet.yaml.

. /etc/labgrid/lab.conf

# --- system -------------------------------------------------------------

uci set system.@system[0].hostname="$LAB"
uci commit system
grep -q " $LAB\$" /etc/hosts || echo "127.0.1.1 $LAB" >> /etc/hosts

# --- labgrid-dev user ---------------------------------------------------

grep -q '^labgrid-dev:' /etc/group || \
	echo 'labgrid-dev:x:1000:' >> /etc/group
grep -q '^labgrid-dev:' /etc/passwd || \
	echo 'labgrid-dev:x:1000:1000:labgrid:/home/labgrid-dev:/bin/ash' >> /etc/passwd
grep -q '^labgrid-dev:' /etc/shadow || \
	echo 'labgrid-dev:*:0:0:99999:7:::' >> /etc/shadow
sed -i '/^dialout:/{/labgrid-dev/!s/$/,labgrid-dev/;s/:,/:/}' /etc/group

mkdir -p /home/labgrid-dev/.ssh
[ -f /home/labgrid-dev/.ssh/labgrid ] || {
	ssh-keygen -q -t ed25519 -N '' -C labgrid -f /home/labgrid-dev/.ssh/labgrid
	cat /home/labgrid-dev/.ssh/labgrid.pub >> /home/labgrid-dev/.ssh/authorized_keys
}
chown -R labgrid-dev:labgrid-dev /home/labgrid-dev /etc/labgrid
chmod 700 /home/labgrid-dev/.ssh /root/.ssh
chmod 600 /home/labgrid-dev/.ssh/authorized_keys /root/.ssh/authorized_keys

for dir in $TFTP_DIRS; do
	mkdir -p "$dir"
	chown labgrid-dev:labgrid-dev "$dir"
done
mkdir -p /srv/tftp
chown labgrid-dev:labgrid-dev /srv/tftp

grep -q '^[@#]includedir /etc/sudoers.d' /etc/sudoers || \
	echo '@includedir /etc/sudoers.d' >> /etc/sudoers

# --- network: uplink via DHCP, one 802.1q VLAN per DUT ------------------

uci -q delete network.lan
uci -q delete network.wan
uci -q delete network.wan6
for dev in $(uci show network | sed -n "s/^network\.\([^.]*\)=device$/\1/p"); do
	[ "$(uci -q get network.$dev.name)" = br-lan ] && uci delete network.$dev
done

uci set network.wan=interface
uci set network.wan.proto=dhcp
uci set network.wan.device="$WAN"
uci set network.wan6=interface
uci set network.wan6.proto=dhcpv6
uci set network.wan6.device="$WAN"

uci -q delete dhcp.lan
uci -q delete dhcp.wan
uci set dhcp.wan=dhcp
uci set dhcp.wan.interface=wan
uci set dhcp.wan.ignore=1

uci -q delete firewall.@zone[0].network

for vid in $VLANS; do
	uci set network.vlan$vid=device
	uci set network.vlan$vid.type=8021q
	uci set network.vlan$vid.ifname="$TRUNK"
	uci set network.vlan$vid.vid="$vid"
	uci set network.vlan$vid.name="vlan$vid"

	# the second address is in the DUT's default LAN for direct access
	uci set network.lab$vid=interface
	uci set network.lab$vid.proto=static
	uci set network.lab$vid.device="vlan$vid"
	uci add_list network.lab$vid.ipaddr="192.168.$vid.1/24"
	uci add_list network.lab$vid.ipaddr="192.168.1.$vid/24"

	uci set dhcp.lab$vid=dhcp
	uci set dhcp.lab$vid.interface="lab$vid"
	uci set dhcp.lab$vid.start=100
	uci set dhcp.lab$vid.limit=101
	uci set dhcp.lab$vid.leasetime=24h
	uci set dhcp.lab$vid.dhcpv4=server
	uci set dhcp.lab$vid.ra=disabled
	uci set dhcp.lab$vid.dhcpv6=disabled

	uci add_list firewall.@zone[0].network="lab$vid"
done
uci commit network

# --- dnsmasq: DHCP + TFTP -----------------------------------------------

uci set dhcp.@dnsmasq[0].enable_tftp=1
uci set dhcp.@dnsmasq[0].tftp_root=/srv/tftp
uci commit dhcp

# --- firewall: zone[0] (lan) holds the DUT VLANs, allow SSH from WAN ----

uci set firewall.@zone[0].name=lab
uci -q delete firewall.@forwarding[0]
uci add firewall forwarding >/dev/null
uci set firewall.@forwarding[-1].src=lab
uci set firewall.@forwarding[-1].dest=wan
uci -q delete firewall.ssh_wan
uci set firewall.ssh_wan=rule
uci set firewall.ssh_wan.name=Allow-SSH-WAN
uci set firewall.ssh_wan.src=wan
uci set firewall.ssh_wan.proto=tcp
uci set firewall.ssh_wan.dest_port=22
uci set firewall.ssh_wan.target=ACCEPT
uci commit firewall

# --- uhttpd: pdudaemon compatible API on localhost:16421 ----------------

uci -q delete uhttpd.pdu
uci set uhttpd.pdu=uhttpd
uci add_list uhttpd.pdu.listen_http=127.0.0.1:16421
uci set uhttpd.pdu.home=/www-pdu
uci set uhttpd.pdu.cgi_prefix=/power
uci set uhttpd.pdu.script_timeout=120
uci set uhttpd.pdu.max_requests=8
uci commit uhttpd

# --- services -----------------------------------------------------------

# ser2net is started by the exporter for each serial port
/etc/init.d/ser2net disable 2>/dev/null
/etc/init.d/sshd enable
/etc/init.d/labgrid-coordinator enable
/etc/init.d/labgrid-exporter enable

exit 0
